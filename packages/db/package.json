{
  "name": "@recensio/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./config.ts",
    "./table": "./table.ts",
    "./service": "./service.ts",
    "./database": "./database.ts",
    "./schema/*": "./schema/*.ts",
    "./auth": "./auth.ts",
    "./client": "./client.ts"
  },
  "scripts": {
    "check:types": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "bun --env-file=../../.env run migrate.ts",
    "studio": "bun --env-file=../../.env run drizzle-kit studio",
    "studio:prod": "bun --env-file=../../.env.prod run drizzle-kit studio"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/docker": "catalog:",
    "@alchemy.run/drizzle": "catalog:",
    "@alchemy.run/sql": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@yielded/auth": "catalog:",
    "@yielded/auth-persistence-drizzle": "catalog:",
    "alchemy": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
