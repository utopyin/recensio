# Deployment (`bun run deploy` / `bun run destroy`, loaded with --env-file .env.deploy).
# Not named `.env.production`: Bun loads that file by itself whenever NODE_ENV is production, which
# alchemy sets for the processes it starts, so these values would leak into `alchemy dev`.

# Optional name of the Cloudflare Hyperdrive config; defaults to `recensio`.
HYPERDRIVE_NAME=

# Postgres origin behind the Hyperdrive: the data-only app role. The password is write-only
# on Cloudflare's side, so it must be supplied here; it is re-put on every deploy.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Owner connection used only by the migration step at deploy (DDL rights).
DB_MIGRATE_URL=
