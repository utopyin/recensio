# Deployment (`bun run deploy` / `bun run destroy`, loaded with --env-file .env.deploy).
# Not named `.env.production`: Bun loads that file by itself whenever NODE_ENV is production, which
# alchemy sets for the processes it starts, so these values would leak into `alchemy dev`.

# Optional name of the Cloudflare Hyperdrive config; defaults to `recensio`.
HYPERDRIVE_NAME=

# Postgres origin behind the Hyperdrive: the data-only app role. The password is write-only
# on Cloudflare's side, so it must be supplied here; it is re-put on every deploy.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Owner connection used only by the migration step at deploy (DDL rights).
DB_MIGRATE_URL=

# Where browsers reach the website, `https://recensio.example`: the only origin auth trusts.
SITE_ORIGIN=

# Auth secrets, 32 random bytes each, base64url (`openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`).
# One signs sign-in codes, the other ties a sign-in to the browser that started it.
AUTH_PROOF_KEY=
AUTH_BINDING_KEY=

# Who sign-in codes come from: an address on a domain Cloudflare Email may send for.
AUTH_EMAIL_FROM=

# Who may open an account, comma-separated: an exact address, `*@domain`, or `*` for anyone.
# Empty lets nobody new in. Under `alchemy dev` anyone may.
SIGN_UP_ALLOWED_EMAILS=
